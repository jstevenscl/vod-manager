
# secrets — never commit
.env
*.env
.env.*
!.env.example
_workshop/

# local per-machine deploy overrides (real container/volume names, local
# image tags) — never something another deployer's compose run should see
docker-compose.override.yml

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
backend/venv/

# frontend
node_modules/
frontend/dist/

# build artifacts
backend/static/

# runtime data (config.json, sessions.json, sqlite DBs — never commit real credentials/data)
/data/
backend/data/
backend/devdata/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# ad-hoc verification screenshots / browser automation output
.playwright-mcp/
/*.png

# os/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# entire beads tracker lives in the private dev repo now, not here --
# see C:\Tools\scripts\Release-ToPublic.ps1 / EDM CURRENT.md for the
# private->public release workflow this repo is paired with
.beads/
